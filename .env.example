# Copy to .env and fill in. NEVER commit .env.
# Accounts on QRL Zond are ML-DSA-87; there is no secp256k1 private key.
DEPLOYER_MNEMONIC="<34-word QRL mnemonic>"

# Private network only. scripts/qrl.js refuses any non-local host unless
# ALLOW_PUBLIC_RPC=1, so that iterating never litters the shared public testnet.
# Point this at the Kurtosis enclave's mapped EL port (see CLAUDE.md section 4).
QRL_RPC_URL="http://127.0.0.1:8545"
QRL_CHAIN_ID=3151908

# Optional role holders wired at deploy time; omit to keep everything on the deployer.
# SEASON_ADMIN_ROLE is not among them: QurrlPhaseMinter must be its only holder, so
# SEASON_ADMIN_ADDRESS is ignored by deploy and revoked by handover.
# CURATOR_ADDRESS="Q..."
# TREASURER_ADDRESS="Q..."

# Governance: the splitter's and QurrlPhaseMinter's governance at deploy, and where
# `npm run handover` moves the admin roles. A multisig until ArkTimelock has Qurrl rows.
# GOVERNANCE_ADDRESS="Q..."

# QurrlPhaseMinter, each defaulting to the deployer: the owner (operations multisig,
# setReqPts / setMintFee inside the compiled bounds) and the Acorn oracle (posts the
# per-epoch Acorn Merkle root).
# MINTER_OWNER_ADDRESS="Q..."
# ACORN_ORACLE_ADDRESS="Q..."
# The ecosystem ArkPhase (ark-ecosystem-contracts). Unset, deploy creates an ArkPhaseDouble stand-in that
# anyone can set; never leave it unset where the ecosystem phase means anything.
# ARK_PHASE_ADDRESS="Q..."

# Collection metadata. Art does not exist yet: BASE_URI is a placeholder and the
# trait palette ships with placeholder variant counts (see CLAUDE.md section 6).
# QURRL_NAME="Qurrl"
# QURRL_SYMBOL="QURRL"
# QURRL_BASE_URI="https://qurrl.qrl/meta/"

# Escape hatch for a deliberate public deployment. Leave unset.
# ALLOW_PUBLIC_RPC=1
