pragma hyperion >=0.0.1;

import "../lib/openzeppelin/utils/Strings.hyp";

/// Test-only. Lets a live chain answer whether the vendored Strings library works on it.
contract StringsProbe {
    function decimal(uint256 value) external pure returns (string memory) {
        return Strings.toString(value);
    }
}
